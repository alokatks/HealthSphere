# Copy this file to .env.development / .env.production and fill in real values.
# .env, .env.development, .env.production, and .env.local are all git-ignored
# (see .gitignore) — this is the only env file meant to be committed.

# Display name shown in the UI (Navbar, AppLogo, browser tab title, etc.)
VITE_APP_NAME=HealthSphere

# Base URL of the Spring Boot backend API, no trailing slash.
# Dev:  http://localhost:8080
# Prod: set to your deployed backend's URL before building for production.
VITE_API_BASE_URL=